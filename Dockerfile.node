FROM node:16-alpine

# 创建应用目录
WORKDIR /app

# 复制package.json和package-lock.json
COPY package*.json ./

# 安装依赖
RUN npm install

# 复制应用代码
COPY . .

# 设置环境变量
ENV PORT=3000
ENV DEEPSEEK_API_KEY=sk-453aa010dca34e33b279fef31aceae5b

# 构建应用
RUN npm run build

# 暴露端口
EXPOSE 3000

# 启动应用
CMD ["node", "server.js"]
